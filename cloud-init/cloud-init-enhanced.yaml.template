#cloud-config
# ============================================================================
# Linux Base Setup - Enhanced Cloud-Init Template
# ============================================================================
# Improved template with enhanced security, portability, and efficiency.
# Includes distro detection, configurable security settings, and optimized commands.
#
# For automated generation from config files, use:
#   ./generate-cloud-init.sh -f ~/.ssh/id_ed25519.pub -o cloud-init.yaml
#
# Validation:
#   cloud-init schema --config-file cloud-init.yaml
# ============================================================================

# --- System Detection ---
# Detect distribution and architecture for portability
bootcmd:
  - |
    # Detect distribution
    if [ -f /etc/os-release ]; then
      . /etc/os-release
      DISTRO=$ID
      DISTRO_FAMILY=$ID_LIKE
    else
      DISTRO="unknown"
      DISTRO_FAMILY=""
    fi

    # Detect architecture
    ARCH=$(uname -m)

    # Store detection results for later use
    mkdir -p /etc/linux-base-setup
    cat > /etc/linux-base-setup/system-info << EOF
    DISTRO=$DISTRO
    DISTRO_FAMILY=$DISTRO_FAMILY
    ARCH=$ARCH
    EOF

# --- Hostname Configuration ---
# Cloud providers often set this automatically via DHCP/metadata
# Use a prefix pattern for auto-generated names
hostname: srv-${instance-id}
manage_etc_hosts: true
prefer_fqdn_over_hostname: false

# --- Timezone ---
# See: timedatectl list-timezones
timezone: {{TIMEZONE}}  # e.g., America/New_York, Europe/London, UTC

# --- User Configuration ---
users:
  - name: {{ADMIN_USERNAME}}
    groups: [sudo, adm]
    shell: /bin/bash
    # Configurable sudo: use NOPASSWD for automation, ALL for security
    sudo: {{ADMIN_SUDO_CONFIG}}  # e.g., ALL=(ALL) NOPASSWD:ALL or ALL=(ALL) ALL
    lock_passwd: true
    ssh_authorized_keys:
      - {{SSH_PUBLIC_KEY}}
      # Add additional keys as needed:
      # - ssh-ed25519 AAAA... user2@host

# Disable root SSH login
disable_root: true

# --- Package Management ---
package_update: true
package_upgrade: true

packages:
  # Core system packages
  - curl
  - wget
  - gnupg
  - ca-certificates
  # SSH and security
  - openssh-server
  - apparmor
  - apparmor-utils
  # NTP (chrony preferred over systemd-timesyncd)
  - chrony
  # Network tools
  - net-tools
  - iproute2

  # Development tools (make optional via config)
  # Uncomment these if you need development capabilities:
  # - git
  # - vim
  # - software-properties-common
  # - apt-transport-https

# --- Write Configuration Files ---
write_files:
  # ==========================================================================
  # Kernel Hardening (sysctl) - Enhanced with configurability
  # ==========================================================================
  - path: /etc/sysctl.d/99-hardening.conf
    owner: root:root
    permissions: '0644'
    content: |
      # Kernel Hardening Configuration
      # Generated by linux-base-setup cloud-init (enhanced)

      # IP Forwarding (configurable)
      net.ipv4.ip_forward = {{SYSCTL_IP_FORWARDING}}
      net.ipv6.conf.all.forwarding = {{SYSCTL_IP_FORWARDING}}

      # Source routing (disable - prevents IP spoofing)
      net.ipv4.conf.all.accept_source_route = 0
      net.ipv4.conf.default.accept_source_route = 0
      net.ipv6.conf.all.accept_source_route = 0
      net.ipv6.conf.default.accept_source_route = 0

      # ICMP redirects (disable - prevents MITM attacks)
      net.ipv4.conf.all.accept_redirects = 0
      net.ipv4.conf.default.accept_redirects = 0
      net.ipv6.conf.all.accept_redirects = 0
      net.ipv6.conf.default.accept_redirects = 0
      net.ipv4.conf.all.secure_redirects = 0
      net.ipv4.conf.default.secure_redirects = 0

      # Send redirects (disable on non-routers)
      net.ipv4.conf.all.send_redirects = 0
      net.ipv4.conf.default.send_redirects = 0

      # Reverse path filtering (anti-spoofing)
      net.ipv4.conf.all.rp_filter = 1
      net.ipv4.conf.default.rp_filter = 1

      # Log Martians (packets with impossible addresses)
      net.ipv4.conf.all.log_martians = 1
      net.ipv4.conf.default.log_martians = 1

      # SYN flood protection
      net.ipv4.tcp_syncookies = 1
      net.ipv4.tcp_max_syn_backlog = 2048
      net.ipv4.tcp_synack_retries = 2
      net.ipv4.tcp_syn_retries = 5

      # ICMP broadcast/multicast protection
      net.ipv4.icmp_echo_ignore_broadcasts = 1
      net.ipv4.icmp_ignore_bogus_error_responses = 1

      # Kernel hardening
      kernel.dmesg_restrict = 1
      kernel.kptr_restrict = 1
      kernel.randomize_va_space = 2
      kernel.yama.ptrace_scope = 1
      kernel.panic = 10
      kernel.panic_on_oops = 1

      # Core dump restrictions
      fs.suid_dumpable = 0

      # Network performance tuning
      net.core.rmem_max = 134217728
      net.core.wmem_max = 134217728
      net.core.rmem_default = 67108864
      net.core.wmem_default = 67108864
      net.core.netdev_max_backlog = 5000
      net.core.somaxconn = 4096

      # IPv6 hardening (configurable)
      net.ipv6.conf.all.disable_ipv6 = {{SYSCTL_DISABLE_IPV6}}
      net.ipv6.conf.default.disable_ipv6 = {{SYSCTL_DISABLE_IPV6}}
      net.ipv6.conf.lo.disable_ipv6 = 0
      net.ipv6.conf.all.accept_ra = {{SYSCTL_IPV6_ACCEPT_RA}}
      net.ipv6.conf.default.accept_ra = {{SYSCTL_IPV6_ACCEPT_RA}}

      # Filesystem protections
      fs.protected_hardlinks = 1
      fs.protected_symlinks = 1
      fs.protected_fifos = 2
      fs.protected_regular = 2

  # ==========================================================================
  # SSH Daemon Configuration (Enhanced Security)
  # ==========================================================================
  - path: /etc/ssh/sshd_config.d/99-hardening.conf
    owner: root:root
    permissions: '0600'
    content: |
      # SSH Hardening Configuration
      # Generated by linux-base-setup cloud-init (enhanced)

      # Network
      Port {{SSH_PORT}}
      AddressFamily inet

      # Protocol
      Protocol 2

      # Modern secure ciphers and key exchange (unchanged - already secure)
      KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512,diffie-hellman-group-exchange-sha256
      Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
      MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256
      HostKeyAlgorithms ssh-ed25519,rsa-sha2-512,rsa-sha2-256

      # Logging
      SyslogFacility AUTH
      LogLevel VERBOSE

      # Authentication (enhanced)
      LoginGraceTime 30s
      PermitRootLogin no
      StrictModes yes
      MaxAuthTries 3
      MaxSessions 10

      # Key-only authentication (enhanced security)
      PubkeyAuthentication yes
      PasswordAuthentication no
      PermitEmptyPasswords no
      ChallengeResponseAuthentication no
      KbdInteractiveAuthentication no

      # Disable Kerberos/GSSAPI
      KerberosAuthentication no
      GSSAPIAuthentication no

      # PAM (required for some features)
      UsePAM yes

      # Forwarding (now configurable for security)
      AllowAgentForwarding {{SSH_ALLOW_AGENT_FORWARDING}}
      AllowTcpForwarding {{SSH_ALLOW_TCP_FORWARDING}}
      X11Forwarding no

      # Client keepalive (5 min interval, 2 missed = disconnect)
      ClientAliveInterval 300
      ClientAliveCountMax 2

      # Other
      PrintMotd no
      PrintLastLog yes
      TCPKeepAlive yes
      AcceptEnv LANG LC_*

  # ==========================================================================
  # SSH Banner (Security Awareness)
  # ==========================================================================
  - path: /etc/ssh/banner
    owner: root:root
    permissions: '0644'
    content: |
      ###############################################################################
      #                                                                             #
      #                    AUTHORIZED ACCESS ONLY                                   #
      #                                                                             #
      #  This system is for authorized use only. All activity is monitored and     #
      #  logged. Unauthorized access or use may result in disciplinary action      #
      #  and/or civil and criminal penalties.                                      #
      #                                                                             #
      #  System hardened by Linux Base Setup                                        #
      #                                                                             #
      ###############################################################################

  # ==========================================================================
  # Disable Uncommon Network Protocols (Security)
  # ==========================================================================
  - path: /etc/modprobe.d/uncommon-protocols.conf
    owner: root:root
    permissions: '0644'
    content: |
      # Disable uncommon network protocols for security
      install dccp /bin/true
      install sctp /bin/true
      install rds /bin/true
      install tipc /bin/true

  # ==========================================================================
  # Disable Uncommon Filesystems (Security)
  # ==========================================================================
  - path: /etc/modprobe.d/uncommon-filesystems.conf
    owner: root:root
    permissions: '0644'
    content: |
      # Disable uncommon filesystems for security
      install cramfs /bin/true
      install freevxfs /bin/true
      install jffs2 /bin/true
      install hfs /bin/true
      install hfsplus /bin/true
      install udf /bin/true

  # ==========================================================================
  # Core Dump Restrictions (Security)
  # ==========================================================================
  - path: /etc/security/limits.d/10-coredump.conf
    owner: root:root
    permissions: '0644'
    content: |
      # Disable core dumps for security
      * hard core 0
      * soft core 0

  # ==========================================================================
  # Enhanced Security Limits
  # ==========================================================================
  - path: /etc/security/limits.d/20-security.conf
    owner: root:root
    permissions: '0644'
    content: |
      # Enhanced security limits
      * hard nofile 65536
      * soft nofile 65536
      * hard nproc 4096
      * soft nproc 4096

  # ==========================================================================
  # Umask Configuration (Security)
  # ==========================================================================
  - path: /etc/profile.d/umask.sh
    owner: root:root
    permissions: '0644'
    content: |
      # Set secure default umask
      umask 027

  # ==========================================================================
  # AppArmor Configuration (Security)
  # ==========================================================================
  - path: /etc/apparmor/parser.conf
    owner: root:root
    permissions: '0644'
    content: |
      # AppArmor configuration for enhanced security
      # This enables AppArmor for better application sandboxing

  # ==========================================================================
  # Cloud-Init Completion Marker (Tracking)
  # ==========================================================================
  - path: /etc/linux-base-setup/cloud-init-completed
    owner: root:root
    permissions: '0644'
    content: |
      # Cloud-init hardening completed
      # Enhanced template with security, portability, and efficiency improvements
      #
      # Security features enabled:
      # - SSH key-only authentication
      # - Configurable SSH forwarding restrictions
      # - IPv6 configurability
      # - AppArmor integration
      # - Enhanced sysctl hardening
      #
      # To complete hardening, run:
      #   sudo ./harden.sh --skip-users --skip-ssh-basic
      #
      # This will add:
      # - CrowdSec IPS
      # - Auditd logging
      # - RKHunter rootkit detection
      # - SSH 2FA (optional)
      # - UFW/Firewalld rules
      # - Unattended upgrades

# --- Run Commands (Optimized and Consolidated) ---
runcmd:
  # ==========================================================================
  # System Setup and Validation
  # ==========================================================================
  - |
    set -e  # Exit on error for better error handling

    # Load system detection info
    if [ -f /etc/linux-base-setup/system-info ]; then
      . /etc/linux-base-setup/system-info
    fi

    echo "=== Linux Base Setup Cloud-Init (Enhanced) ==="
    echo "Distribution: $DISTRO"
    echo "Architecture: $ARCH"
    echo "Timestamp: $(date)"
    echo "=========================================="

  # ==========================================================================
  # Apply System Hardening (Consolidated)
  # ==========================================================================
  - |
    # Apply sysctl settings with error checking
    if sysctl --system; then
      echo "✓ Sysctl hardening applied successfully"
    else
      echo "⚠ Warning: Some sysctl settings may not have applied"
    fi

  # ==========================================================================
  # SSH Configuration and Keys (Enhanced)
  # ==========================================================================
  - |
    # Generate all modern SSH host keys (improved)
    echo "Generating SSH host keys..."
    for keytype in rsa ed25519 ecdsa; do
      keyfile="/etc/ssh/ssh_host_${keytype}_key"
      if [ ! -f "$keyfile" ]; then
        if ssh-keygen -t "$keytype" -f "$keyfile" -N ""; then
          echo "✓ Generated $keytype host key"
        else
          echo "⚠ Failed to generate $keytype host key"
        fi
      else
        echo "✓ $keytype host key already exists"
      fi
    done

    # Enable SSH banner if not already configured
    if ! grep -q "^Banner" /etc/ssh/sshd_config 2>/dev/null; then
      echo "Banner /etc/ssh/banner" >> /etc/ssh/sshd_config
      echo "✓ SSH banner enabled"
    fi

    # Restart SSH service with error handling
    if systemctl restart sshd; then
      echo "✓ SSH service restarted successfully"
    else
      echo "⚠ Warning: SSH service restart failed"
    fi

  # ==========================================================================
  # Service Management (Portable)
  # ==========================================================================
  - |
    # Enable and start NTP service (with portability)
    if command -v systemctl >/dev/null 2>&1; then
      # systemd systems (most modern Linux)
      if systemctl enable chrony && systemctl start chrony; then
        echo "✓ Chrony NTP service enabled and started"
      else
        echo "⚠ Warning: Chrony service management failed"
      fi
    elif command -v service >/dev/null 2>&1; then
      # SysV init systems
      if service chrony start && chkconfig chrony on; then
        echo "✓ Chrony NTP service enabled and started (SysV)"
      else
        echo "⚠ Warning: Chrony service management failed (SysV)"
      fi
    else
      echo "⚠ Warning: No supported init system found for NTP"
    fi

  # ==========================================================================
  # AppArmor Setup (Security Enhancement)
  # ==========================================================================
  - |
    # Enable AppArmor if available
    if command -v apparmor_status >/dev/null 2>&1; then
      if systemctl enable apparmor 2>/dev/null && systemctl start apparmor 2>/dev/null; then
        echo "✓ AppArmor enabled and started"
      else
        echo "✓ AppArmor available but may already be running"
      fi
    else
      echo "ℹ AppArmor not available on this system"
    fi

  # ==========================================================================
  # Final Setup and Logging
  # ==========================================================================
  - |
    # Create necessary directories
    mkdir -p /etc/linux-base-setup /var/log/linux-base-setup

    # Log completion with system info
    cat > /var/log/cloud-init-hardening.log << EOF
    === Cloud-Init Hardening Complete ===
    Timestamp: $(date)
    Distribution: $DISTRO
    Architecture: $ARCH
    Admin User: {{ADMIN_USERNAME}}
    SSH Port: {{SSH_PORT}}
    IPv6 Disabled: {{SYSCTL_DISABLE_IPV6}}
    SSH Agent Forwarding: {{SSH_ALLOW_AGENT_FORWARDING}}
    SSH TCP Forwarding: {{SSH_ALLOW_TCP_FORWARDING}}
    =====================================
    EOF

    echo "✓ Cloud-init hardening completed successfully"
    echo "Check /var/log/cloud-init-hardening.log for details"

# --- Final Message ---
final_message: |
  ===========================================
  Linux Base Setup - Cloud-Init Complete
  ===========================================
  Enhanced hardening applied with security, portability, and efficiency improvements.

  System Information:
    Distribution: $DISTRO
    Architecture: $ARCH

  SSH Access:
    ssh -p {{SSH_PORT}} {{ADMIN_USERNAME}}@<PUBLIC_IP>

  Security Features Enabled:
    ✓ SSH key-only authentication
    ✓ Configurable SSH forwarding
    ✓ IPv6 hardening (configurable)
    ✓ AppArmor integration
    ✓ Enhanced sysctl settings
    ✓ Core dump restrictions

  To complete hardening (CrowdSec, 2FA, etc.):
    curl -sSL https://raw.githubusercontent.com/crxnit/Linux-Base-Setup-2026/main/install.sh | sudo bash
    sudo ./harden.sh --skip-users --skip-ssh-basic

  Logs: /var/log/cloud-init-hardening.log
  Cloud-init completed in $UPTIME seconds.
  ===========================================

# ============================================================================
# PLACEHOLDERS TO REPLACE (Enhanced Configuration)
# ============================================================================
# Core Settings:
# {{TIMEZONE}}                   - Your timezone (e.g., America/New_York)
# {{ADMIN_USERNAME}}             - Admin username (e.g., admin, deploy)
# {{SSH_PUBLIC_KEY}}             - Your SSH public key (ssh-ed25519 AAAA... user@host)
# {{SSH_PORT}}                   - SSH port (default: 22, recommended: 2222)
#
# Security Settings:
# {{ADMIN_SUDO_CONFIG}}          - Sudo config: "ALL=(ALL) NOPASSWD:ALL" or "ALL=(ALL) ALL"
# {{SSH_ALLOW_AGENT_FORWARDING}} - SSH agent forwarding: "yes" or "no"
# {{SSH_ALLOW_TCP_FORWARDING}}   - SSH TCP forwarding: "yes" or "no"
# {{SYSCTL_IP_FORWARDING}}       - IP forwarding: 0 (disabled) or 1 (enabled)
# {{SYSCTL_DISABLE_IPV6}}        - Disable IPv6: 0 (no) or 1 (yes)
# {{SYSCTL_IPV6_ACCEPT_RA}}      - IPv6 accept router advertisements: 0 (no) or 1 (yes)
# ============================================================================