#cloud-config
# ============================================================================
# Linux Base Setup - Cloud-Init Template
# ============================================================================
# Manual template for cloud-init configuration.
# Replace {{PLACEHOLDER}} values with your settings.
#
# For automated generation from config files, use:
#   ./generate-cloud-init.sh -f ~/.ssh/id_ed25519.pub -o cloud-init.yaml
#
# Validation:
#   cloud-init schema --config-file cloud-init.yaml
# ============================================================================

# --- Hostname Configuration ---
# Cloud providers often set this automatically via DHCP/metadata
# Use a prefix pattern for auto-generated names
hostname: srv-${instance-id}
manage_etc_hosts: true
prefer_fqdn_over_hostname: false

# --- Timezone ---
# See: timedatectl list-timezones
timezone: {{TIMEZONE}}  # e.g., America/New_York, Europe/London, UTC

# --- User Configuration ---
users:
  - name: {{ADMIN_USERNAME}}
    groups: [sudo, adm]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - {{SSH_PUBLIC_KEY}}
      # Add additional keys as needed:
      # - ssh-ed25519 AAAA... user2@host

# Disable root SSH login
disable_root: true

# --- Package Management ---
package_update: true
package_upgrade: true

packages:
  # Essential tools
  - curl
  - wget
  - git
  - vim
  - gnupg
  - apt-transport-https
  - ca-certificates
  - software-properties-common
  # SSH
  - openssh-server
  # NTP (choose one)
  - chrony
  # - systemd-timesyncd

# --- Write Configuration Files ---
write_files:
  # ==========================================================================
  # Kernel Hardening (sysctl)
  # ==========================================================================
  - path: /etc/sysctl.d/99-hardening.conf
    owner: root:root
    permissions: '0644'
    content: |
      # Kernel Hardening Configuration
      # Generated by linux-base-setup cloud-init

      # IP Forwarding (0 = disabled, 1 = enabled)
      net.ipv4.ip_forward = 0
      net.ipv6.conf.all.forwarding = 0

      # Source routing (disable - prevents IP spoofing)
      net.ipv4.conf.all.accept_source_route = 0
      net.ipv4.conf.default.accept_source_route = 0
      net.ipv6.conf.all.accept_source_route = 0
      net.ipv6.conf.default.accept_source_route = 0

      # ICMP redirects (disable - prevents MITM attacks)
      net.ipv4.conf.all.accept_redirects = 0
      net.ipv4.conf.default.accept_redirects = 0
      net.ipv6.conf.all.accept_redirects = 0
      net.ipv6.conf.default.accept_redirects = 0
      net.ipv4.conf.all.secure_redirects = 0
      net.ipv4.conf.default.secure_redirects = 0

      # Send redirects (disable on non-routers)
      net.ipv4.conf.all.send_redirects = 0
      net.ipv4.conf.default.send_redirects = 0

      # Reverse path filtering (anti-spoofing)
      net.ipv4.conf.all.rp_filter = 1
      net.ipv4.conf.default.rp_filter = 1

      # Log Martians (packets with impossible addresses)
      net.ipv4.conf.all.log_martians = 1
      net.ipv4.conf.default.log_martians = 1

      # SYN flood protection
      net.ipv4.tcp_syncookies = 1
      net.ipv4.tcp_max_syn_backlog = 2048
      net.ipv4.tcp_synack_retries = 2
      net.ipv4.tcp_syn_retries = 5

      # ICMP broadcast/multicast protection
      net.ipv4.icmp_echo_ignore_broadcasts = 1
      net.ipv4.icmp_ignore_bogus_error_responses = 1

      # Kernel hardening
      kernel.dmesg_restrict = 1
      kernel.kptr_restrict = 1
      kernel.randomize_va_space = 2
      kernel.yama.ptrace_scope = 1
      kernel.panic = 10
      kernel.panic_on_oops = 1

      # Core dump restrictions
      fs.suid_dumpable = 0

      # Network performance tuning
      net.core.rmem_max = 134217728
      net.core.wmem_max = 134217728
      net.core.rmem_default = 67108864
      net.core.wmem_default = 67108864
      net.core.netdev_max_backlog = 5000
      net.core.somaxconn = 4096

      # IPv6 hardening (disable RA to prevent rogue router attacks)
      net.ipv6.conf.all.disable_ipv6 = 0
      net.ipv6.conf.default.disable_ipv6 = 0
      net.ipv6.conf.lo.disable_ipv6 = 0
      net.ipv6.conf.all.accept_ra = 0
      net.ipv6.conf.default.accept_ra = 0

      # Filesystem protections
      fs.protected_hardlinks = 1
      fs.protected_symlinks = 1
      fs.protected_fifos = 2
      fs.protected_regular = 2

  # ==========================================================================
  # SSH Daemon Configuration (Hardened)
  # ==========================================================================
  - path: /etc/ssh/sshd_config.d/99-hardening.conf
    owner: root:root
    permissions: '0600'
    content: |
      # SSH Hardening Configuration
      # Generated by linux-base-setup cloud-init

      # Network
      Port {{SSH_PORT}}
      AddressFamily inet

      # Protocol
      Protocol 2

      # Modern secure ciphers and key exchange
      KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512,diffie-hellman-group-exchange-sha256
      Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
      MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256
      HostKeyAlgorithms ssh-ed25519,rsa-sha2-512,rsa-sha2-256

      # Logging
      SyslogFacility AUTH
      LogLevel VERBOSE

      # Authentication
      LoginGraceTime 30s
      PermitRootLogin no
      StrictModes yes
      MaxAuthTries 3
      MaxSessions 10

      # Key-only authentication (no passwords)
      PubkeyAuthentication yes
      PasswordAuthentication no
      PermitEmptyPasswords no
      ChallengeResponseAuthentication no
      KbdInteractiveAuthentication no

      # Disable Kerberos/GSSAPI
      KerberosAuthentication no
      GSSAPIAuthentication no

      # PAM (required for some features)
      UsePAM yes

      # Forwarding
      AllowAgentForwarding yes
      AllowTcpForwarding yes
      X11Forwarding no

      # Client keepalive (5 min interval, 2 missed = disconnect)
      ClientAliveInterval 300
      ClientAliveCountMax 2

      # Other
      PrintMotd no
      PrintLastLog yes
      TCPKeepAlive yes
      AcceptEnv LANG LC_*

  # ==========================================================================
  # SSH Banner
  # ==========================================================================
  - path: /etc/ssh/banner
    owner: root:root
    permissions: '0644'
    content: |
      ###############################################################################
      #                                                                             #
      #                    AUTHORIZED ACCESS ONLY                                   #
      #                                                                             #
      #  This system is for authorized use only. All activity is monitored and     #
      #  logged. Unauthorized access or use may result in disciplinary action      #
      #  and/or civil and criminal penalties.                                      #
      #                                                                             #
      ###############################################################################

  # ==========================================================================
  # Disable Uncommon Network Protocols
  # ==========================================================================
  - path: /etc/modprobe.d/uncommon-protocols.conf
    owner: root:root
    permissions: '0644'
    content: |
      # Disable uncommon network protocols
      install dccp /bin/true
      install sctp /bin/true
      install rds /bin/true
      install tipc /bin/true

  # ==========================================================================
  # Disable Uncommon Filesystems
  # ==========================================================================
  - path: /etc/modprobe.d/uncommon-filesystems.conf
    owner: root:root
    permissions: '0644'
    content: |
      # Disable uncommon filesystems
      install cramfs /bin/true
      install freevxfs /bin/true
      install jffs2 /bin/true
      install hfs /bin/true
      install hfsplus /bin/true
      install udf /bin/true

  # ==========================================================================
  # Core Dump Restrictions
  # ==========================================================================
  - path: /etc/security/limits.d/10-coredump.conf
    owner: root:root
    permissions: '0644'
    content: |
      # Disable core dumps
      * hard core 0
      * soft core 0

  # ==========================================================================
  # Umask Configuration
  # ==========================================================================
  - path: /etc/profile.d/umask.sh
    owner: root:root
    permissions: '0644'
    content: |
      # Set secure default umask
      umask 027

  # ==========================================================================
  # Cloud-Init Completion Marker
  # ==========================================================================
  - path: /etc/linux-base-setup/cloud-init-completed
    owner: root:root
    permissions: '0644'
    content: |
      # Cloud-init hardening completed
      # To complete hardening, run:
      #   sudo harden --skip-users --skip-ssh-basic

# --- Run Commands ---
runcmd:
  # Apply sysctl settings
  - sysctl --system

  # Generate Ed25519 SSH host key if missing
  - |
    if [ ! -f /etc/ssh/ssh_host_ed25519_key ]; then
      ssh-keygen -t ed25519 -f /etc/ssh/ssh_host_ed25519_key -N ""
    fi

  # Enable SSH banner
  - |
    if ! grep -q "^Banner" /etc/ssh/sshd_config; then
      echo "Banner /etc/ssh/banner" >> /etc/ssh/sshd_config
    fi

  # Restart SSH to apply new configuration
  - systemctl restart sshd

  # Enable and start NTP service (chrony)
  - systemctl enable chrony
  - systemctl start chrony

  # Create directory for linux-base-setup marker
  - mkdir -p /etc/linux-base-setup

  # Log completion
  - echo "Cloud-init hardening completed at $(date)" >> /var/log/cloud-init-hardening.log

# --- Final Message ---
final_message: |
  ===========================================
  Linux Base Setup - Cloud-Init Complete
  ===========================================
  System hardened and ready.

  SSH Access:
    ssh -p {{SSH_PORT}} {{ADMIN_USERNAME}}@<PUBLIC_IP>

  To complete hardening (CrowdSec, 2FA, etc.):
    curl -sSL https://raw.githubusercontent.com/crxnit/Linux-Base-Setup-2026/main/install.sh | sudo bash
    sudo harden

  Cloud-init completed in $UPTIME seconds.
  ===========================================

# ============================================================================
# PLACEHOLDERS TO REPLACE:
# ============================================================================
# {{TIMEZONE}}        - Your timezone (e.g., America/New_York)
# {{ADMIN_USERNAME}}  - Admin username (e.g., admin, deploy)
# {{SSH_PUBLIC_KEY}}  - Your SSH public key (ssh-ed25519 AAAA... user@host)
# {{SSH_PORT}}        - SSH port (default: 22, recommended: 2222)
# ============================================================================
